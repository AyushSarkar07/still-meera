# Copy this file to .env (which is git-ignored) and fill in real values.
# Never commit .env or paste these values into chat.

# From @BotFather. Format: 123456789:ABC...
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token

# Numeric ID of Meera's private channel, e.g. -1001234567890.
# Only posts from this chat are processed.
TELEGRAM_CHAT_ID=-100replace

# From Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace-with-your-gemini-key

# Any current model ID from https://ai.google.dev/gemini-api/docs/models that supports
# audio input and JSON output. Check that page; model IDs change over time.
GEMINI_MODEL=

# Product assumption: notes scoring below this (0-10) are held, not drafted.
# 6 is a starting point to tune after reviewing real notes, not a validated cut-off.
TRIAGE_THRESHOLD=6

# Optional. Maximum paid attempts per note before it stops retrying. Default 2.
# MAX_ATTEMPTS=2
# Optional. Send reviews somewhere other than the capture channel. Defaults to TELEGRAM_CHAT_ID.
# REVIEW_CHAT_ID=

# --- Only needed for the Vercel (webhook) deployment. See "Deploy on Vercel" in README. ---
# Postgres connection string. Vercel's Neon integration sets DATABASE_URL for you.
# Leave unset locally to keep using the SQLite file in data/.
# DATABASE_URL=
# Random string (letters, digits, _ and -). Must be the same here and in Vercel,
# because `python -m still_meera set-webhook` sends it to Telegram.
# TELEGRAM_WEBHOOK_SECRET=
# Random string. Vercel Cron sends it so only Vercel can trigger the retry job.
# CRON_SECRET=
